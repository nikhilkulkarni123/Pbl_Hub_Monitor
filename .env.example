# SAME Neon/PostgreSQL database used by the PBL portal.
# The monitor opens every DB session in read-only mode.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Private key that the HoD types once to open the monitor.
MONITOR_ACCESS_KEY=replace-with-a-long-private-access-key

# Separate random secret used to sign the 30-day monitor session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MONITOR_SESSION_SECRET=replace-with-a-long-random-secret

# Optional. Defaults to 4.
DB_POOL_MAX=4

# Optional. Set true only when you want to preview the UI without a database.
DEMO_MODE=false
